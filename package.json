{
  "name": "hansana-ranaweera-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "build": "npm run build --workspace @hansana/frontend",
    "start": "npm run start --workspace @hansana/backend",
    "admin:create": "node scripts/create-admin.mjs",
    "seed": "node scripts/seed.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check:assets": "node scripts/check-assets.mjs",
    "verify:start": "node scripts/verify-production.mjs",
    "dev:frontend": "npm run dev --workspace @hansana/frontend",
    "dev:backend": "npm run dev --workspace @hansana/backend"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
